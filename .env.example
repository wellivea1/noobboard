HSD_PORT=8787
HSD_COMPACT_PORT=8788

UNRAID_BASE_URL=https://tower.local
UNRAID_API_KEY=replace_me
# UNRAID_API_KEY_FILE=C:\path\to\unraid.key
# Optional fallback if the Unraid GraphQL API omits Docker containers:
# UNRAID_SSH_FALLBACK_ENABLED=false
# UNRAID_SSH_HOST=tower.local
# UNRAID_SSH_USER=root
# UNRAID_SSH_KEY_FILE=C:\path\to\unraid-ssh-key

UNIFI_BASE_URL=https://192.168.1.1
UNIFI_API_KEY=replace_me
# UNIFI_API_KEY_FILE=C:\path\to\unifi.key
UNIFI_SITE_ID=default

OPENAI_API_KEY=replace_me

NOTIFICATION_BACKEND=ntfy
NTFY_TOPIC_URL=https://ntfy.sh/replace_me
