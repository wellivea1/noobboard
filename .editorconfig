# Editor defaults. Pairs with .gitattributes: that file controls what git
# writes, this one controls what an editor writes back.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
# gofmt's output, not a preference.
indent_style = tab
indent_size = 4

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
